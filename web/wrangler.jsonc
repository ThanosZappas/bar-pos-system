// The dashboard on Cloudflare (free): a Worker that only serves the built files in dist/
// (static assets: unlimited requests on the free plan). Deploy: npm run deploy:dashboard.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "negroni-bar-lab",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./dist" }
}
