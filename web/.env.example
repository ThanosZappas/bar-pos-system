# Copy to .env.local (git-ignored) and fill in from Firebase console →
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the emulators (npm run emulators at the repo root):
# VITE_USE_EMULATORS=true
