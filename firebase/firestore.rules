rules_version = '2';

// Role and active state come from users/{uid}, not from token claims, so deactivation
// and role changes apply immediately. users/* and auditLog/* are written only by
// Cloud Functions (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true
        && me().mustChangePassword == false;
    }
    function hasRole(roles) {
      return isStaff() && me().role in roles;
    }
    function isAdmin() {
      return hasRole(['admin']);
    }
    // Barman and admin run the bar: they never need permission and have every right.
    function isLead() {
      return hasRole(['admin', 'barman']);
    }

    // ── Rights per server (users/{uid}.rights, set by the admin through Cloud Functions).
    // A missing right means its default: everything allowed except working without approval. ──
    function may(right) {
      return isLead() || me().get('rights', {}).get(right, true) == true;
    }
    // A server works only with today's approval (shifts/{uid}, valid until the next 18:00) or with
    // the "works without asking" right. Two hours of grace let writes queued offline just before
    // 18:00 still sync.
    function onShift() {
      let shift = /databases/$(database)/documents/shifts/$(request.auth.uid);
      return isLead()
        || me().get('rights', {}).get('noApproval', false) == true
        || (exists(shift) && get(shift).data.status == 'approved'
          && request.time < get(shift).data.approvedUntil + duration.value(2, 'h'));
    }
    function canWork() {
      return isStaff() && onShift();
    }

    // Every client write carries who and when (reportable later); the server clock is enforced.
    function stampedUpdate() {
      let d = request.resource.data;
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time
        && d.createdAt == resource.data.createdAt && d.createdBy == resource.data.createdBy;
    }
    function stampedCreate() {
      let d = request.resource.data;
      return d.createdBy == request.auth.uid && d.createdAt == request.time
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function listed(d) {
      return d.order is number && d.hidden is bool && d.archived is bool;
    }
    function stampKeys() {
      return ['createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    match /users/{uid} {
      // Everyone may read their own profile (needed for the forced password change screen).
      allow get: if signedIn() && request.auth.uid == uid;
      // The barman lists servers to give them permission.
      allow read: if isLead();
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Menu: staff read, admin edits. Deleting = archived:true (keeps history reportable). ──
    function validSection(d) {
      return d.keys().hasOnly(['name', 'note', 'order', 'hidden', 'archived'].concat(stampKeys()))
        && text(d.name, 1, 60) && text(d.note, 0, 200) && listed(d);
    }
    function validCategory(d) {
      return d.keys().hasOnly(['sectionId', 'name', 'order', 'hidden', 'archived'].concat(stampKeys()))
        && text(d.sectionId, 1, 100) && text(d.name, 1, 60) && listed(d);
    }
    function validItem(d) {
      return d.keys().hasOnly(['categoryId', 'name', 'description', 'priceCents', 'tags', 'order', 'hidden', 'archived'].concat(stampKeys()))
        && text(d.categoryId, 1, 100) && text(d.name, 1, 80) && text(d.description, 0, 500)
        && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 1000000
        && d.tags is list && d.tags.size() <= 5 && listed(d);
    }
    match /menuSections/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && stampedCreate() && validSection(request.resource.data);
      allow update: if isAdmin() && stampedUpdate() && validSection(request.resource.data);
      allow delete: if false;
    }
    match /menuCategories/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && stampedCreate() && validCategory(request.resource.data);
      allow update: if isAdmin() && stampedUpdate() && validCategory(request.resource.data);
      allow delete: if false;
    }
    match /menuItems/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && stampedCreate() && validItem(request.resource.data);
      allow update: if isAdmin() && stampedUpdate() && validItem(request.resource.data);
      allow delete: if false;
    }

    // ── Tables: staff read, admin adds/renames/reorders. Removal only via the removeTable
    // function, which first checks that the table has no open order. ──
    function validTable(d) {
      return d.keys().hasOnly(['name', 'order', 'archived', 'currentSessionId'].concat(stampKeys()))
        && text(d.name, 1, 20) && d.order is number && d.archived is bool && text(d.currentSessionId, 10, 64);
    }
    match /tables/{tableId} {
      allow read: if isStaff();
      allow create: if isAdmin() && stampedCreate() && validTable(request.resource.data)
        && request.resource.data.archived == false;
      allow update: if (isAdmin() && stampedUpdate() && validTable(request.resource.data)
          && changesOnly(['name', 'order', 'updatedAt', 'updatedBy']))
        || isClosing(tableId);
      allow delete: if false;
    }

    // Closing a paid table (any staff): the table gets a fresh session id and, in the same batch,
    // the old session is recorded in sessions/{oldSessionId}. Closed sessions never change.
    function isClosing(tableId) {
      let old = resource.data.currentSessionId;
      let next = request.resource.data.currentSessionId;
      return canWork() && may('closeTables') && stampedUpdate()
        && changesOnly(['currentSessionId', 'updatedAt', 'updatedBy'])
        && text(next, 10, 64) && next != old
        && existsAfter(/databases/$(database)/documents/sessions/$(old))
        && getAfter(/databases/$(database)/documents/sessions/$(old)).data.tableId == tableId;
    }
    match /sessions/{sessionId} {
      allow read: if isStaff();
      allow create: if canWork() && may('closeTables')
        && request.resource.data.keys().hasOnly(['tableId', 'tableName', 'closedAt', 'closedBy', 'closedByName',
          'totalCents', 'paidCents', 'roundCount'])
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.closedAt == request.time
        && text(request.resource.data.closedByName, 0, 60)
        && request.resource.data.totalCents is int && request.resource.data.paidCents is int
        && request.resource.data.roundCount is int
        && request.resource.data.paidCents >= request.resource.data.totalCents
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.currentSessionId == sessionId
        && getAfter(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.currentSessionId != sessionId;
      allow update, delete: if false;
    }

    // ── Rounds (orders). Ids are generated on the phone, so retries after a reconnect overwrite
    // the same document instead of duplicating it. Every change is written in one batch with an
    // event in rounds/{id}/events, and the rules check that pairing in both directions. ──
    function roundKeys() {
      return ['tableId', 'tableName', 'sessionId', 'status', 'items', 'note',
        'createdAt', 'createdBy', 'createdByName', 'clientCreatedAt', 'updatedAt', 'updatedBy',
        'editCount', 'editSeen', 'lastEventId',
        'openedAt', 'openedBy',
        'servedAt', 'servedBy', 'servedByName',
        'cancelledAt', 'cancelledBy', 'cancelledByName',
        'lastEditAt', 'lastEditBy', 'lastEditByName'];
    }
    function eventAfter(roundId, eventId) {
      return getAfter(/databases/$(database)/documents/rounds/$(roundId)/events/$(eventId)).data;
    }
    // The write carries a new lastEventId whose event (of this type) exists once the batch commits.
    function loggedAs(roundId, type) {
      let eventId = request.resource.data.lastEventId;
      return eventId is string
        && (resource == null || eventId != resource.data.lastEventId)
        && existsAfter(/databases/$(database)/documents/rounds/$(roundId)/events/$(eventId))
        && eventAfter(roundId, eventId).type == type;
    }
    function validNewRound() {
      let d = request.resource.data;
      return d.keys().hasOnly(roundKeys())
        && d.keys().hasAll(['tableId', 'tableName', 'sessionId', 'status', 'items', 'note', 'createdAt', 'createdBy',
          'createdByName', 'clientCreatedAt', 'updatedAt', 'updatedBy', 'editCount', 'editSeen', 'lastEventId'])
        && text(d.tableId, 1, 100) && text(d.tableName, 1, 20) && text(d.sessionId, 10, 64)
        && d.status == 'preparing'
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 50
        && text(d.note, 0, 300) && text(d.createdByName, 0, 60)
        && d.clientCreatedAt is timestamp
        && stampedCreate()
        && d.editCount == 0 && d.editSeen == true;
    }
    function roundTouched() {
      let d = request.resource.data;
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function wasPreparing() {
      return resource.data.status == 'preparing';
    }
    // Edit quantities, notes or cancel single lines: only while Preparing; flagged for the barman.
    function isEdit(roundId) {
      let d = request.resource.data;
      return wasPreparing() && d.status == 'preparing'
        && changesOnly(['items', 'note', 'editCount', 'editSeen', 'lastEditAt', 'lastEditBy', 'lastEditByName',
          'updatedAt', 'updatedBy', 'lastEventId'])
        && d.items is list && d.items.size() == resource.data.items.size()
        && text(d.note, 0, 300)
        && d.editCount == resource.data.editCount + 1 && d.editSeen == false
        && d.lastEditAt == request.time && d.lastEditBy == request.auth.uid
        && loggedAs(roundId, 'edited');
    }
    function isServe(roundId) {
      let d = request.resource.data;
      return wasPreparing() && d.status == 'served'
        && changesOnly(['status', 'servedAt', 'servedBy', 'servedByName', 'updatedAt', 'updatedBy', 'lastEventId'])
        && d.servedAt == request.time && d.servedBy == request.auth.uid
        && loggedAs(roundId, 'served');
    }
    function isCancel(roundId) {
      let d = request.resource.data;
      return wasPreparing() && d.status == 'cancelled'
        && changesOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelledByName', 'editSeen',
          'updatedAt', 'updatedBy', 'lastEventId'])
        && d.cancelledAt == request.time && d.cancelledBy == request.auth.uid && d.editSeen == false
        && may('cancelOrders')
        && loggedAs(roundId, 'cancelled');
    }
    // Undo an accidental "Served" within 2 minutes (server clock): back to Preparing, logged.
    function isUnserve(roundId) {
      let d = request.resource.data;
      return resource.data.status == 'served' && d.status == 'preparing'
        && request.time < resource.data.servedAt + duration.value(120, 's')
        && changesOnly(['status', 'servedAt', 'servedBy', 'servedByName', 'updatedAt', 'updatedBy', 'lastEventId'])
        && !('servedAt' in d) && !('servedBy' in d) && !('servedByName' in d)
        && loggedAs(roundId, 'unserved');
    }
    // A late round (its bill was closed, or its table removed) is added to a table's current bill.
    function isRebill(roundId) {
      let d = request.resource.data;
      let target = get(/databases/$(database)/documents/tables/$(d.tableId)).data;
      let oldTable = get(/databases/$(database)/documents/tables/$(resource.data.tableId)).data;
      return resource.data.status in ['preparing', 'served']
        && changesOnly(['tableId', 'tableName', 'sessionId', 'updatedAt', 'updatedBy', 'lastEventId'])
        && (exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId)) || oldTable.archived == true)
        && target.archived == false
        && d.sessionId == target.currentSessionId && d.tableName == target.name
        && loggedAs(roundId, 'moved');
    }
    // The barman (or admin) opening a round on the board: clears the "new"/"edited" highlight.
    function isOpen() {
      let d = request.resource.data;
      return hasRole(['admin', 'barman'])
        && changesOnly(['openedAt', 'openedBy', 'editSeen', 'updatedAt', 'updatedBy'])
        && d.openedAt == request.time && d.openedBy == request.auth.uid && d.editSeen == true;
    }
    match /rounds/{roundId} {
      allow read: if isStaff();
      allow create: if canWork() && validNewRound() && loggedAs(roundId, 'created');
      allow update: if canWork() && roundTouched()
        && (isEdit(roundId) || isServe(roundId) || isCancel(roundId) || isUnserve(roundId) || isRebill(roundId) || isOpen());
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow create: if canWork()
          && request.resource.data.keys().hasOnly(['type', 'at', 'by', 'byName', 'changes', 'note'])
          && request.resource.data.type in ['created', 'edited', 'served', 'cancelled', 'unserved', 'moved']
          && request.resource.data.at == request.time
          && request.resource.data.by == request.auth.uid
          && text(request.resource.data.byName, 0, 60)
          && getAfter(/databases/$(database)/documents/rounds/$(roundId)).data.lastEventId == eventId;
        allow update, delete: if false;
      }
    }

    // ── Payments: immutable. A mistake is corrected by a full reversal with a reason, whose id
    // is derived from the original ("reversal-<id>"), so a payment can be reversed only once.
    // Overpayment is blocked in the apps (rules cannot sum payments). ──
    function isReversal(paymentId) {
      let d = request.resource.data;
      let original = get(/databases/$(database)/documents/payments/$(d.reversalOf)).data;
      return paymentId == 'reversal-' + d.reversalOf
        && original.amountCents > 0 && d.amountCents == -original.amountCents
        && d.sessionId == original.sessionId && d.tableId == original.tableId && d.method == original.method
        && text(d.reason, 1, 200);
    }
    function validPayment(paymentId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tableId', 'tableName', 'sessionId', 'amountCents', 'method', 'reversalOf', 'reason',
          'createdAt', 'createdBy', 'createdByName', 'clientCreatedAt'])
        && d.keys().hasAll(['tableId', 'tableName', 'sessionId', 'amountCents', 'method',
          'createdAt', 'createdBy', 'createdByName', 'clientCreatedAt'])
        && text(d.tableId, 1, 100) && text(d.tableName, 1, 20) && text(d.sessionId, 10, 64)
        && d.amountCents is int && d.method in ['cash', 'card']
        && d.createdBy == request.auth.uid && d.createdAt == request.time
        && text(d.createdByName, 0, 60) && d.clientCreatedAt is timestamp
        && (('reversalOf' in d && may('reversePayments') && isReversal(paymentId))
          || (!('reversalOf' in d) && !('reason' in d) && may('payments') && d.amountCents > 0 && d.amountCents <= 10000000));
    }
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create: if canWork() && validPayment(paymentId);
      allow update, delete: if false;
    }

    // ── Permission to work, one document per server. The server asks ("requested"); the barman
    // or admin decides ("approved" until the next 18:00, "denied", or later "revoked") and may
    // also approve without being asked. ──
    function shiftKeys() {
      return ['uid', 'displayName', 'shiftDay', 'status', 'requestedAt', 'decidedAt', 'decidedBy', 'decidedByName', 'approvedUntil'];
    }
    function isShiftRequest(uid) {
      let d = request.resource.data;
      return request.auth.uid == uid && d.status == 'requested' && d.requestedAt == request.time
        && !d.keys().hasAny(['decidedAt', 'decidedBy', 'decidedByName', 'approvedUntil']);
    }
    function isShiftDecision() {
      let d = request.resource.data;
      return isLead() && d.status in ['approved', 'denied', 'revoked']
        && d.decidedBy == request.auth.uid && d.decidedAt == request.time && text(d.decidedByName, 0, 60)
        && (d.status != 'approved'
          || (d.approvedUntil is timestamp && d.approvedUntil > request.time
            && d.approvedUntil < request.time + duration.value(25, 'h')));
    }
    match /shifts/{uid} {
      allow read: if isStaff() && (request.auth.uid == uid || isLead());
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(shiftKeys())
        && request.resource.data.uid == uid
        && text(request.resource.data.displayName, 0, 60) && text(request.resource.data.shiftDay, 10, 10)
        && (isShiftRequest(uid) || isShiftDecision());
      allow delete: if false;
    }

    // ── Settings shown on the non-fiscal summary. Staff read, admin writes. ──
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() && id == 'app'
        && request.resource.data.keys().hasOnly(['barName', 'address', 'phone', 'receiptFooter', 'updatedAt', 'updatedBy'])
        && text(request.resource.data.barName, 1, 60) && text(request.resource.data.address, 0, 120)
        && text(request.resource.data.phone, 0, 40) && text(request.resource.data.receiptFooter, 0, 200)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }

    // Everything else stays closed until its milestone adds rules and tests.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
